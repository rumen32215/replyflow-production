# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Cloud API (Meta Embedded Signup + webhook)
# App ID and Config ID are not secret — Meta's JS SDK requires them
# client-side. App Secret and the webhook verify token must stay server-only.
WHATSAPP_APP_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v20.0
NEXT_PUBLIC_WHATSAPP_APP_ID=
NEXT_PUBLIC_WHATSAPP_CONFIG_ID=

# AI — Reply Engine (Sprint 10A). LLM_PROVIDER selects the adapter in
# lib/reply-engine/llm/providers/ — "openai" is the only one implemented
# so far. OPENAI_MODEL_SMALL is used for the cheap Understanding Engine
# classification call, OPENAI_MODEL_LARGE for reply generation — both
# default to gpt-4o-mini if unset.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_SMALL=gpt-4o-mini
OPENAI_MODEL_LARGE=gpt-4o-mini

# Support (Master Execution Plan 1.5). A real, monitored inbox — the
# Settings "Get help" section only renders once this is set, so the
# app never claims a support channel exists before someone's actually
# watching it. See DOCS/SPECS/ReplyFlow-Customer-Support-Workflow.md.
SUPPORT_EMAIL=

# Billing (Master Execution Plan 3.1). One flat plan — STRIPE_PRICE_ID
# is a Price created in the Stripe dashboard, where the actual amount
# is set; this codebase never needs to know the number itself. Every
# billing route responds with a plain "not set up yet" until all three
# are set — see DOCS/SPECS/ReplyFlow-Billing-Subscription-Lifecycle.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Internal admin tools (Master Execution Plan 3.3). Comma-separated
# real email addresses — /admin checks a real Supabase-authenticated
# session against this allowlist (lib/admin.ts) before anything is
# shown; unset means nobody can reach it, never "everyone can."
ADMIN_EMAILS=

# Owner Attention Architecture (DOCS/CONSTITUTION/14-ReplyFlow-Owner-
# Attention-Architecture.md). RESEND_API_KEY and ATTENTION_FROM_EMAIL
# (a real address on a domain verified with Resend, e.g.
# "ReplyFlow <notify@yourdomain.com>") together activate real email
# delivery — both unset means app/api/cron/attention honestly does
# nothing, same convention as SUPPORT_EMAIL/ADMIN_EMAILS above.
# CRON_SECRET authenticates Vercel's own cron dispatch (see
# vercel.json) — Vercel sends it automatically as a Bearer token once
# this is set; an unset or mismatched secret rejects the request.
RESEND_API_KEY=
ATTENTION_FROM_EMAIL=
CRON_SECRET=
